            <select id="seTillageInput" class="form-control">
              <option value="siembra_directa" data-i18n="opt_til_sd">Siembra Directa continua</option>
              <option value="labranza_vertical" data-i18n="opt_til_vert">Labranza vertical / cincel ocasional</option>
              <option value="convencional" data-i18n="opt_til_conv">Labranza convencional (reja/rastra)</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="se_inp_moist">Humedad Inicial (%)</label>
            <input type="number" id="seMoistureInput" class="form-control no-wheel" min="15" max="100" value="62" />
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="se_inp_aw">Agua Disponible AW (mm/m)</label>
            <input type="number" id="seAwInput" class="form-control no-wheel" min="50" max="240" value="130" />
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="se_inp_soc">SOC Inicial (g/kg)</label>
            <input type="number" step="0.1" id="seSocInput" class="form-control no-wheel" min="5" max="50" value="18.4" />
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="se_inp_tosca">Profundidad útil / Tosca (cm)</label>
            <select id="seToscaInput" class="form-control">
              <option value="100">Sin limitante (&gt; 100 cm)</option>
              <option value="75">Tosca moderada (75 cm)</option>
              <option value="50">Tosca somera (50 cm)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="wizard-footer-nav" style="margin-top:20px; padding-top:16px;">
        <button class="btn-pill btn-outline" onclick="closeStrategyEditor()" data-i18n="btn_cancel">Cancelar</button>
        <button class="btn-pill btn-forest" onclick="saveStrategyFromEditor()" data-i18n="se_btn_save">Guardar Estrategia en Comparativa ✓</button>
      </div>
    </div>
  </div>

  <!-- MODAL DIRECTORIO DE LOS 15 CRITERIOS Y CONCEPTOS -->
  <div class="modal-backdrop" id="conceptDirectoryModal" role="dialog" aria-modal="true" onclick="if(event.target===this) closeConceptDirectoryModal()">
    <div class="modal-card modal-card-wide">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; gap:8px;">
        <span class="trust-badge trust-green"><span class="trust-dot"></span> <span data-i18n="dir_badge">Glosario Científico-Agronómico Completo</span></span>
        <button class="btn-pill btn-outline btn-sm" onclick="closeConceptDirectoryModal()" data-i18n="btn_close">Cerrar ✕</button>
      </div>
      <h3 class="modal-title-serif" data-i18n="dir_title">¿Qué significa cada dato, criterio (C1–C15) y método matemático?</h3>
      <p class="muted-sub" style="margin-bottom:14px;" data-i18n="dir_sub">Explorá cada criterio y concepto en lenguaje simple con su ecuación exacta y fuente oficial NASA/INTA.</p>
      <div id="conceptDirectoryBody" class="dir-cards-grid"></div>
    </div>
  </div>

  <!-- Datos iniciales inyectados desde Express -->
  <script>
    window.__INITIAL_DATA__ = <%- JSON.stringify(initialData) %>;
  </script>

  <!-- Librerías Frontend -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script src="https://cdn.jsdelivr.net/npm/@turf/turf@6/turf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <!-- Lógica Interactiva Cliente v3.0 -->
  <script src="/js/client.js"></script>
</body>
</html>
