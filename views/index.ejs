<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Field Shift v4.0 — Rotación Inteligente de Cultivos</title>

  <!-- Tipografía Editorial (Cormorant Garamond + Inter según DESIGN.md) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

  <!-- Estilos Pastoral Editorial + Modo Oscuro -->
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>

  <!-- FRANJA SUPERIOR VIVID LIME -->
  <div class="lime-marquee" role="region" aria-label="Información científica">
    <div class="marquee-track" id="marqueeTrack">
      <span class="marquee-item" data-i18n="mq_1">✓ NASA Space Apps 2026 — Field Shift v4.0 (FAO-56 · FAO-33 · MCDA)</span>
      <span class="marquee-item" data-i18n="mq_2">✓ NASA POWER Serie Diaria + SoilGrids Q0.05–Q0.95 + INTA SIGA + Sentinel-2 NDVI</span>
      <span class="marquee-item" data-i18n="mq_3">✓ Filtro Aptitud · Auditoría SAW-15 · TOPSIS-15 · Monte Carlo (N=10.000)</span>
      <span class="marquee-item" data-i18n="mq_4">✓ Licencia Abierta Apache 2.0 — Ciclos 1 a 6 Años &amp; Mini-Tutorial Interactivo</span>
      <span class="marquee-item" data-i18n="mq_1">✓ NASA Space Apps 2026 — Field Shift v4.0 (FAO-56 · FAO-33 · MCDA)</span>
      <span class="marquee-item" data-i18n="mq_2">✓ NASA POWER Serie Diaria + SoilGrids Q0.05–Q0.95 + INTA SIGA + Sentinel-2 NDVI</span>
      <span class="marquee-item" data-i18n="mq_3">✓ Filtro Aptitud · Auditoría SAW-15 · TOPSIS-15 · Monte Carlo (N=10.000)</span>
      <span class="marquee-item" data-i18n="mq_4">✓ Licencia Abierta Apache 2.0 — Ciclos 1 a 6 Años &amp; Mini-Tutorial Interactivo</span>
    </div>
  </div>

  <!-- CABECERA FOREST INK -->
  <header class="site-header">
    <div class="header-inner">
      <div class="wizard-header-status">
        <span class="step-pill-indicator" id="headerStepBadge" data-i18n="hdr_ready">Listo para iniciar cálculo</span>
      </div>

      <a href="#" class="brand-lockup" onclick="resetWizardToHome(event)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 20L12 3L20 20H4Z" fill="#e8fe85"/>
          <path d="M12 3V20" stroke="#07503f" stroke-width="1.8"/>
        </svg>
        <span>field shift</span>
      </a>

      <div class="header-actions">
        <button id="btnReplayTutorial" class="btn-pill btn-outline-light btn-sm" onclick="startStepPointerTutorial(CLIENT_STATE.currentStep || 1, true)" style="display:none;" title="Repetir mini-tutorial con puntero">
          🎯 <span data-i18n="btn_tour_hdr">Tutorial</span>
        </button>
        <button class="btn-pill btn-outline-light btn-sm" onclick="openConceptDirectoryModal()" title="Guía de criterios y fórmulas">
          <span data-i18n="btn_guide_hdr">📘 Guía</span>
        </button>
        <button id="themeToggleBtn" class="btn-pill btn-outline-light btn-sm" onclick="toggleDarkMode()" aria-label="Cambiar modo oscuro">
          🌙 <span data-i18n="btn_theme_dark">Oscuro</span>
        </button>
        <button id="langToggle" class="btn-pill btn-outline-light btn-sm" onclick="toggleLanguage()">ES | EN</button>
      </div>
    </div>
  </header>

  <!-- PANTALLA DE INICIO -->
  <section id="heroLanding" class="hero-section">
    <span class="hero-eyebrow" data-i18n="hero_eyebrow">Observación Terrestre NASA · Decisión Agronómica Guiada</span>
    <h1 class="hero-title" data-i18n="hero_title">Elegí la mejor rotación viendo exactamente qué cambia en tu suelo</h1>
    <p class="hero-subtitle" data-i18n="hero_sub">
      Un recorrido guiado en 4 pasos: delimitá tu lote con grilla NDVI real, elegí estado inicial y duración (1 a 6 años), diseñá tus estrategias con sus propias condiciones y obtené resultados explicados en cada dato.
    </p>
    <div class="hero-cta-group">
      <button class="btn-pill btn-white btn-hero-start" onclick="startGuidedCalculation()" data-i18n="hero_start_btn">
        Hacer un cálculo →
      </button>
    </div>
  </section>

  <!-- ESPACIO DE TRABAJO GUIADO -->
  <main id="wizardWorkspace" class="wizard-workspace" style="display:none;">

    <!-- BARRA DE PROGRESO -->
    <div class="stepper-bar">
      <div class="container stepper-inner">
        <div class="step-node active" id="stepNode1">
          <span class="step-num">1</span>
          <span class="step-label" data-i18n="st_1">Lote y Mapa NDVI</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-node locked" id="stepNode2">
          <span class="step-num">2</span>
          <span class="step-label" data-i18n="st_2">Suelo y Estrategias</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-node locked" id="stepNode3">
          <span class="step-num">3</span>
          <span class="step-label" data-i18n="st_3">Línea de Tiempo</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-node locked" id="stepNode4">
          <span class="step-num">4</span>
          <span class="step-label" data-i18n="st_4">Resultados y Criterios</span>
        </div>
      </div>
    </div>

    <!-- ======================================================================
         PASO 1: DELIMITACIÓN DEL LOTE, NDVI POR CUADRO, CICLO (1-6 AÑOS) Y ESTADO INICIAL
         ====================================================================== -->
    <section id="wizardStep1" class="band band-bone wizard-step-panel">
      <div class="container">
        <div class="section-header">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <span class="section-kicker" style="margin-bottom:0;" data-i18n="s1_kicker">Paso 1 de 4 · Delimitación Espacial, NDVI Interno y Estado de Partida</span>
            <button type="button" class="btn-eq" onclick="startStepPointerTutorial(1, true)">🎯 <span data-i18n="btn_mini_tut">Mini-tutorial del paso</span></button>
          </div>
          <h2 class="section-title" data-i18n="s1_title">Marcá los puntos de tu lote para inspeccionar el NDVI por cuadro e iniciar el ciclo</h2>
          <p class="section-intro" data-i18n="s1_intro">
            Hacé clic sobre la imagen satelital para marcar tu parcela (mínimo 3 puntos). Cada cuadro interno muestra su color y valor exacto de NDVI Sentinel-2 acorde al estado inicial del campo. Hacé clic en cualquier cuadro del mapa para ver su diagnóstico.
          </p>
        </div>

        <div class="map-wrapper">
          <div>
            <div class="map-guide-strip">
              <span data-i18n="s1_map_hint">Hacé clic en las esquinas del lote o tocá un cuadro interno de color para leer su NDVI exacto.</span>
              <span id="vertexCountBadge" class="trust-badge trust-green"><span class="trust-dot"></span> 4 vértices</span>
            </div>

            <div id="map" aria-label="Mapa satelital interactivo con capa NDVI por cuadro"></div>

            <div class="map-toolbar">
              <button class="btn-pill btn-outline btn-sm" onclick="undoLastPoint()" data-i18n="btn_undo">↩ Quitar último punto</button>
              <button class="btn-pill btn-outline btn-sm" onclick="clearPolygon()" data-i18n="btn_clear">Limpiar mapa</button>
              <button class="btn-pill btn-outline btn-sm" onclick="loadGuaminiPreset(true)" data-i18n="btn_preset">Cargar Guaminí (100.000 m²)</button>
            </div>

            <!-- LEYENDA INTERACTIVA DE NDVI + DISTRIBUCIÓN DE CUADROS INTERNOS -->
            <div class="ndvi-legend">
              <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                <div style="display:flex; align-items:center; flex-wrap:wrap; gap:8px;">
                  <strong style="font-size:13px;" data-i18n="ndvi_title">Grilla NDVI Realista por Cuadro (Sentinel-2 — 10 m)</strong>
                  <span id="meanNdviBadge" class="delta-pill delta-up">NDVI medio lote: 0,68</span>
                </div>
                <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                  <button class="btn-eq" id="toggleNdviNumbersBtn" onclick="toggleNdviNumbers()" data-i18n="btn_ndvi_nums_hide">🔢 Ocultar números</button>
                  <button class="btn-eq" id="toggleNdviLayerBtn" onclick="toggleNdviOverlay()" data-i18n="btn_ndvi_hide">👁️ Ocultar capa NDVI</button>
                  <button class="btn-eq" onclick="openInfoPopup('ndvi')">? <span data-i18n="btn_explain">¿Qué significa?</span></button>
                </div>
              </div>
              <div class="ndvi-bar"></div>
              <div class="ndvi-ticks">
                <span data-i18n="ndvi_t0">0,00–0,19 Suelo desnudo (Terracota)</span>
                <span data-i18n="ndvi_t1">0,20–0,44 Rastrojo/Baja (Ocre)</span>
                <span data-i18n="ndvi_t2">0,45–0,69 Cultivo activo (Salvia)</span>
                <span data-i18n="ndvi_t3">0,70+ Vigor pleno (Verde)</span>
              </div>
              <div id="ndviSpatialSummary" class="ndvi-spatial-summary"></div>
            </div>
          </div>

          <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
              <span class="trust-badge trust-green"><span class="trust-dot"></span> <span data-i18n="poly_ready">Polígono Validado</span></span>
              <button class="btn-eq" onclick="openInfoPopup('area')">ƒx WGS84 · ?</button>
            </div>

            <div class="metric-pill-box">
              <div class="metric-pill-label" data-i18n="lbl_area">Superficie Calculada del Lote</div>
              <div class="metric-pill-value" id="areaM2Display">100.000 m²</div>
              <div class="muted-sub" id="areaHaDisplay">10,00 hectáreas · 4 vértices</div>
            </div>

            <div class="metric-pill-box">
              <div class="metric-pill-label" data-i18n="lbl_loc">Centroide y Jurisdicción (API Georef)</div>
              <div style="font-size:15px; font-weight:600; margin-top:4px;" id="centroidDisplay">-36,805506° S, -62,026496° O</div>
              <div class="muted-sub" id="jurisdictionDisplay"><%= initialData.envContext.georef.etiqueta %></div>
            </div>

            <div class="grid-2" style="gap:12px;">
              <div class="form-group">
                <label class="form-label">
                  <span data-i18n="lbl_start_date">Inicio del ciclo</span>
                </label>
                <input type="date" id="startDateInput" class="form-control" value="2026-02-15" />
              </div>
              <div class="form-group">
                <label class="form-label">
                  <span data-i18n="lbl_duration">Duración del ciclo</span>
                  <button type="button" class="btn-help-inline" onclick="openInfoPopup('cycle_years')" title="Explicar duración de ciclos">?</button>
                </label>
                <select id="cycleYearsInput" class="form-control" onchange="onGlobalCycleYearsChange()">
                  <option value="1" data-i18n="opt_1y">1 año (12 meses · Campaña)</option>
                  <option value="2" selected data-i18n="opt_2y">2 años (24 meses)</option>
                  <option value="3" data-i18n="opt_3y">3 años (36 meses · Trienal)</option>
                  <option value="4" data-i18n="opt_4y">4 años (48 meses)</option>
                  <option value="5" data-i18n="opt_5y">5 años (60 meses)</option>
                  <option value="6" data-i18n="opt_6y">6 años (72 meses · Ciclo INTA)</option>
                </select>
              </div>
            </div>

            <div class="form-group" style="margin-bottom:10px;">
              <label class="form-label">
                <span data-i18n="lbl_prev_crop">Cultivo inicial o estado actual del campo</span>
                <button type="button" class="btn-help-inline" onclick="openInfoPopup('prev_crop')" title="Explicar cultivo/estado inicial">?</button>
              </label>
              <select id="prevCropInput" class="form-control" onchange="onPrevCropChange()"></select>
            </div>

            <!-- TARJETA DINÁMICA QUE EXPLICA EL IMPACTO DEL ESTADO INICIAL EN EL LOTE Y EL NDVI -->
            <div id="initialStateSummaryCard" class="init-state-preview-card"></div>
          </div>
        </div>

        <!-- BARRA DE NAVEGACIÓN DEL PASO 1 -->
        <div class="wizard-footer-nav">
          <button class="btn-pill btn-outline" onclick="resetWizardToHome()" data-i18n="btn_back_home">← Volver al inicio</button>
          <button class="btn-pill btn-forest" id="btnNextStep1" onclick="goToStep(2)" data-i18n="btn_to_s2">
            Completar Paso 1 y seguir al Paso 2 →
          </button>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         PASO 2: DATOS DE APIS, PARÁMETROS BASE Y CONSTRUCTOR DE ESTRATEGIAS
         ====================================================================== -->
    <section id="wizardStep2" class="band band-bone wizard-step-panel" style="display:none;">
      <div class="container">
        <div class="section-header">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <span class="section-kicker" style="margin-bottom:0;" data-i18n="s2_kicker">Paso 2 de 4 · Datos Satelitales y Diseño de Estrategias</span>
            <button type="button" class="btn-eq" onclick="startStepPointerTutorial(2, true)">🎯 <span data-i18n="btn_mini_tut">Mini-tutorial del paso</span></button>
          </div>
          <h2 class="section-title" data-i18n="s2_title">Revisá los datos NASA/INTA, ajustá tu lote y diseñá las estrategias a comparar</h2>
          <p class="section-intro" data-i18n="s2_intro">
            Consultamos las APIs abiertas para tu coordenada. Podés ajustar los datos base del lote y luego crear o editar cada estrategia candidata con su secuencia año por año y sus condiciones iniciales antes de enviar todo al motor matemático.
          </p>
        </div>

        <!-- 4 TARJETAS SATELITALES CON BOTONES DE EXPLICACIÓN DETALLADA -->
        <div class="grid-4" style="margin-bottom: 24px;">
          <div class="card card-sage">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
              <span class="trust-badge trust-yellow" id="climaSourceBadge"><span class="trust-dot"></span> NASA POWER + SIGA</span>
              <button class="btn-eq" onclick="openInfoPopup('et0')">? · ƒx ET₀</button>
            </div>
            <div class="card-kicker-lbl" data-i18n="card_rain_lbl">Lluvia y Demanda Calibrada</div>
            <div class="card-big-val" id="rainCardVal"><%= initialData.envContext.clima.lluvia_anual_mm %> mm/año</div>
            <p class="card-sub-txt" id="et0CardSub">ET₀ calibrada: <strong><%= initialData.envContext.clima.et0_anual_mm %> mm/año</strong>.</p>
          </div>

          <div class="card card-sky">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
              <span class="trust-badge trust-yellow" id="soilSourceBadge"><span class="trust-dot"></span> SoilGrids v2.0</span>
              <button class="btn-eq" onclick="openInfoPopup('aw')">? · ƒx AW</button>
            </div>
            <div class="card-kicker-lbl" id="soilTaxSub"><%= initialData.envContext.suelo.taxonomia %></div>
            <div class="card-big-val" id="awCardVal"><%= initialData.envContext.suelo.aw_mm_m.media %> mm/m</div>
            <p class="card-sub-txt" id="awCardSub">IC 90%: <strong><%= initialData.envContext.suelo.aw_mm_m.q05 %>–<%= initialData.envContext.suelo.aw_mm_m.q95 %> mm/m</strong>.</p>
          </div>

          <div class="card card-peach">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
              <span class="trust-badge trust-green"><span class="trust-dot"></span> SMAP L4 + CONAE</span>
              <button class="btn-eq" onclick="openInfoPopup('smap')">? · ƒx Radar</button>
            </div>
            <div class="card-kicker-lbl" data-i18n="card_smap_lbl">Humedad Radicular Inicial</div>
            <div class="card-big-val" id="smapCardVal">0,21 m³/m³</div>
            <p class="card-sub-txt" id="smapCardSub" data-i18n="card_smap_sub">Carga hídrica inicial del 62% en 0–100 cm.</p>
          </div>

          <div class="card card-ash">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
              <span class="trust-badge trust-green"><span class="trust-dot"></span> MAGyP / INDEC</span>
              <button class="btn-eq" onclick="openInfoPopup('magyp')">? · ƒx Riesgo</button>
            </div>
            <div class="card-kicker-lbl" data-i18n="card_magyp_lbl">Estabilidad Rindes 10 años</div>
            <div class="card-big-val">CV 17%–34%</div>
            <p class="card-sub-txt" data-i18n="card_magyp_sub">Sorgo: 5.400 kg/ha (CV 17%). Maíz: 6.900 kg/ha.</p>
          </div>
        </div>

        <!-- PARÁMETROS BASE DEL LOTE -->
        <div class="card" style="margin-bottom: 24px;">
          <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px; margin-bottom:20px;">
            <div>
              <h3 class="card-title-serif" data-i18n="s2_form_title">Parámetros Base del Lote y Manejo del Agricultor</h3>
              <p class="muted-sub" data-i18n="s2_form_sub">Valores globales por defecto (cada estrategia puede heredarlos o definir los suyos abajo).</p>
            </div>
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
              <span id="calibrationStatusBadge" class="trust-badge trust-yellow"><span class="trust-dot"></span> <span data-i18n="badge_sat_mode">Modo Satélite (IC 90%)</span></span>
              <button class="btn-pill btn-outline btn-sm" onclick="resetLocalOverrides()" data-i18n="btn_reset_sat">Restaurar satélite</button>
            </div>
          </div>

          <div class="grid-3">
            <div class="form-group">
              <label class="form-label">
                <span data-i18n="inp_aw">Agua Disponible Perfil (mm/m)</span>
                <button type="button" class="btn-help-inline" onclick="openInfoPopup('aw')">?</button>
              </label>
              <input type="number" id="inputAW" class="form-control no-wheel" value="130" min="50" max="240" onchange="markLocalOverride()" />
              <span class="field-impact-hint" data-i18n="hint_aw">Modifica: Capacidad del tanque hídrico y C2.</span>
            </div>

            <div class="form-group">
              <label class="form-label">
                <span data-i18n="inp_moist">Humedad Inicial del Suelo (%)</span>
                <button type="button" class="btn-help-inline" onclick="openInfoPopup('smap')">?</button>
              </label>
              <input type="number" id="inputInitMoisture" class="form-control no-wheel" value="62" min="15" max="100" onchange="markLocalOverride()" />
              <span class="field-impact-hint" data-i18n="hint_moist">Modifica: Reserva de agua en el Mes 1.</span>
            </div>

            <div class="form-group">
              <label class="form-label">
                <span data-i18n="inp_soc">Carbono Orgánico Lab (g/kg)</span>
                <button type="button" class="btn-help-inline" onclick="openInfoPopup('soc_gei')">?</button>
              </label>
              <input type="number" step="0.1" id="inputSOC" class="form-control no-wheel" value="18.4" min="5" max="50" onchange="markLocalOverride()" />
              <span class="field-impact-hint" data-i18n="hint_soc">Modifica: Línea base SOC y reduce error en C3.</span>
            </div>

            <div class="form-group">
              <label class="form-label">
                <span data-i18n="inp_tosca">Profundidad útil / Tosca (cm)</span>
                <button type="button" class="btn-help-inline" onclick="openInfoPopup('aw')">?</button>
              </label>
              <select id="inputTosca" class="form-control" onchange="markLocalOverride()">
                <option value="100" selected data-i18n="opt_tosca_100">Sin limitante (&gt; 100 cm perfil útil)</option>
                <option value="75" data-i18n="opt_tosca_75">Tosca moderada a 75 cm (-25% agua útil)</option>
                <option value="50" data-i18n="opt_tosca_50">Tosca somera a 50 cm (-50% agua útil)</option>
              </select>
              <span class="field-impact-hint" data-i18n="hint_tosca">Modifica: Lámina máxima almacenada.</span>
            </div>

            <div class="form-group">
              <label class="form-label">
                <span data-i18n="inp_tenure">Tenencia de la tierra</span>
                <button type="button" class="btn-help-inline" onclick="openCriterionPopup('C8')">?</button>
              </label>
              <select id="inputTenure" class="form-control">
                <option value="propietario" selected data-i18n="opt_owner">Propietario (equilibrio suelo + rinde)</option>
                <option value="arrendatario" data-i18n="opt_tenant">Arrendatario 1–2 años (prioriza caja rápida)</option>
              </select>
              <span class="field-impact-hint" data-i18n="hint_tenure">Modifica: Peso de liquidez (C8 y C15).</span>
            </div>

            <div class="form-group">
              <label class="form-label">
                <span data-i18n="inp_mach">Maquinaria y Destino Forrajero</span>
                <button type="button" class="btn-help-inline" onclick="openCriterionPopup('C14')">?</button>
              </label>
              <select id="inputMachinery" class="form-control">
                <option value="contratista_grano" selected data-i18n="opt_mach_grain">Contratista agrícola (solo cosecha grano)</option>
                <option value="mixto_hacienda" data-i18n="opt_mach_livestock">Con ganadería / rollos propios</option>
                <option value="equipo_propio" data-i18n="opt_mach_own">Equipo propio con rolo faca</option>
              </select>
              <span class="field-impact-hint" data-i18n="hint_mach">Modifica: Viabilidad de pastura y sorgo (C8/C14).</span>
            </div>
          </div>
        </div>

        <!-- NUEVA SECCIÓN: CONSTRUCTOR E INTERFAZ DE ESTRATEGIAS DEL PASO 2 -->
        <div class="card card-sage" id="strategyBuilderSection">
          <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-start; gap:14px; margin-bottom:16px;">
            <div>
              <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                <span class="section-kicker" style="margin-bottom:0;" data-i18n="sb_kicker">Constructor de Estrategias a Evaluar</span>
                <span id="strategyCountBadge" class="trust-badge trust-green"><span class="trust-dot"></span> 6 estrategias listas</span>
              </div>
